%% Hermit architecture. Source for docs/architecture.png, rendered with mermaid 11.4.1 (theme "base",
%% Lato, top-down) at 2400 px wide. The README explains the same flow in words under the image.
flowchart TB
  subgraph device [On your iPhone or Mac]
    you([You])
    model[Hermit 1.2 model]
    check[Enclave check]
    tools[Tools]
    policy[Spending policy]
    review[Your review and Face ID]
    keys[Keys in the Secure Enclave]
  end

  cloud[NEAR AI Cloud enclave]
  intents[NEAR Intents 1Click]
  chains["NEAR, EVM chains, Solana, Hyperliquid"]

  you --> model
  you -. Private Cloud .-> check
  check -- proof first, then prompt --> cloud
  model --> tools
  cloud -. tool calls .-> tools
  tools --> policy --> review --> keys
  tools -- quotes --> intents
  keys -- signs --> chains
  intents -- settles --> chains

  classDef nearNode fill:#e9f8f1,stroke:#1f9d6b,color:#0f2a1f
  classDef gate fill:#fff6e5,stroke:#c98a12,color:#2a1d05
  class intents,cloud nearNode
  class policy,review gate
